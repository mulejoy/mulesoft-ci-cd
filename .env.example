# Anypoint Platform connected app credentials
# Create a connected app at: https://anypoint.mulesoft.com/accounts/businessGroups
# Grant scopes: Design Center Developer, Exchange Contributor, CloudHub Network Administrator
ANYPOINT_CLIENT_ID=your-connected-app-client-id
ANYPOINT_CLIENT_SECRET=your-connected-app-client-secret

# CloudHub 2.0 deployment targets (override Maven defaults)
# DEPLOYMENT_ENV=DEV
# DEPLOYMENT_TARGET=Cloudhub-US-East-2
